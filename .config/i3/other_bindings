#This is the config file with USER keybindings that's supposed to be included in i3config file
#You can change it however you want
#------------------------------------------

#layout
exec_always --no-startup-id "setxkbmap -layout us,ru -option grp:toggle" #I found it reasonable to put exec not binding config here

#change wallpaper
bindsym $mod+w exec feh --randomize --bg-scale ~/onepiece/*

#change color scheme and wallpaper (theme)
bindsym $mod+t exec ~/.local/bin/wal-scale.sh

#redshift activate
bindsym F1 exec --no-startup-id redshift-gtk

#lock
bindsym Mod4+l exec betterlockscreen -l --show-layout

#screenshot with flameshot
bindsym Print exec flameshot gui

#ranger
bindsym $mod+p exec alacritty -e ranger

#fastfetch
bindsym $mod+i exec alacritty -e btop 

#floating mode with double click
bindsym --whole-window button2 floating toggle

bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

