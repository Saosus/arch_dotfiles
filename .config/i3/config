font pango:ComicShansMono Nerd Font 14

set $mod Mod1

# xss-lock grabs a logind suspend inhibit lock and will use i3lock to lock the
# screen before suspend. Use loginctl lock-session to lock your screen.
exec --no-startup-id xss-lock --transfer-sleep-lock -- betterlockscreen -l --show-layout

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# Move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
tiling_drag modifier titlebar

#-----CUSTOM: including addtional configs
include ~/.config/i3/keybindings
include ~/.config/i3/other_bindings

#-----CUSTOM: including window themes
set_from_resource $fg i3wm.color1 #f0f0f0
set_from_resource $bg i3wm.color2 #f0f0f0

#class                 border  backgr. text indicator child_border
client.focused          $bg     $bg     $fg  $bg       $bg
client.focused_inactive $bg     $bg     $fg  $bg       $bg
client.unfocused        $bg     $bg     $fg  $bg       $bg
client.urgent           $bg     $bg     $fg  $bg       $bg
client.placeholder      $bg     $bg     $fg  $bg       $bg
client.background       $bg

#-----CUSTOM: autostart 
exec --no-startup-id nm-applet
exec --no-startup-id blueman-applet
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec --no-startup-id ~/.config/i3/scripts/wal-scale.sh
exec --no-startup-id picom

#CUSTOM: gapses and border
gaps inner 20
gaps outer 20
default_border pixel
 
for_window [tiling] border pixel 5
for_window [floating] border pixel 6

for_window [class="Sxiv"] floating enable
for_window [class="mpv"] floating enable
for_window [class="pavucontrol"] floating enable
for_window [class="Telegram"] floating enable
