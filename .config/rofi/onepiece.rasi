* {
    font: "ComicShannsMono Nerd Font Mono 12";
    background: rgba(20, 20, 20, 0.75);
    background-alt: rgba(40, 40, 40, 0.9);
    foreground: #f5c542;
    selected-background: rgba(245, 197, 66, 0.25);
    selected-foreground: #fdf6e3;
    border-color: #f5c542;
    border-radius: 8px;
    padding: 4px;
    margin: 4px;
}

window {
    background-color: @background;
    border: 1px;
    border-color: @border-color;
    border-radius: 10px;
    width: 25%;
    location: center;
}

mainbox {
    padding: 6px;
    background-color: transparent;
    children: [inputbar, listview];
    spacing: 6px;
}

inputbar {
    children: [prompt, entry];
    background-color: @background-alt;
    border-radius: 6px;
    padding: 4px 8px;
}

entry {
    expand: true;
    cursor: text;
    color: @foreground;
}

listview {
    lines: 6;
    fixed-height: false;
    spacing: 4px;
    scrollbar: true;
    background-color: transparent;
    border: 0px;
}

element {
    border: 0;
    padding: 4px;
    border-radius: 6px;
    background-color: transparent;
    text-color: @foreground;
}

element selected {
    background-color: @selected-background;
    text-color: @selected-foreground;
}

element-text {
    text-color: inherit;
    highlight: bold;
}

